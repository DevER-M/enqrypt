# Postgres. On Vercel use the Neon Marketplace integration.
# If omitted in local development, the app uses an on-disk PGlite (PostgreSQL WASM)
# database in .data/pglite. Production refuses to start without DATABASE_URL.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# 32+ random bytes. Generate with: openssl rand -base64 48
JWT_SECRET=

# Upstash Redis (REST API, not the redis:// URL).
# Optional locally: without it realtime falls back to Postgres cursor polling.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public origin used in docs/absolute links. Optional.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# auto = try WebSocket in production, fall back to SSE; sse = force SSE.
NEXT_PUBLIC_REALTIME_TRANSPORT=auto
